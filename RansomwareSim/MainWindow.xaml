<Window x:Class="RansomwareSim.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ransomware Simulator"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#111111">

    <Grid Margin="-9,0,0,-37">

        <!-- Background Gradient -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1A1A1A" Offset="0"/>
                <GradientStop Color="#000000" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Main Card -->
        <Border Width="826"
                Height="538"
                CornerRadius="12"
                BorderBrush="#AA0000"
                BorderThickness="3"
                Background="#1B1B1B"
                HorizontalAlignment="Center"
                VerticalAlignment="Top" Margin="0,10,0,0">

            <StackPanel Margin="30">

                <!-- Warning Icon -->
                <TextBlock Text="⚠"
                           FontSize="70"
                           Foreground="Red"
                           HorizontalAlignment="Center"/>

                <!-- Title -->
                <TextBlock Text="RANSOMWARE"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="Red"
                           HorizontalAlignment="Center"
                           Margin="0,10"/>

                <!-- Educational Notice -->
                <Border Background="#333333"
                        CornerRadius="5"
                        Padding="10"
                        Margin="0,15">

                    <TextBlock TextWrapping="Wrap"
                               Foreground="White"
                               FontSize="16"
                               TextAlignment="Center">
                        This is an ransomware pay the fee to unlock your device Or permanently lose your data.

                    </TextBlock>

                </Border>

                <!-- Fake Status -->
                <StackPanel Margin="0,20">

                    <TextBlock Text="Encyption Status"
                               Foreground="White"
                               FontWeight="Bold"
                               FontSize="18"/>

                    <ProgressBar Height="22"
                                 Value="100"
                                 Foreground="Red"
                                 Margin="0,8"/>

                    <TextBlock Text="Encryption Complete"
                               Foreground="Red"
                               FontWeight="Bold"
                               FontSize="16"/>

                </StackPanel>

                <StackPanel Height="104">
                    <TextBlock Text="Enter Email to Proceed with Payment:"
                                Foreground="Red"
                               FontWeight="Bold" Height="14" Width="679"/>
                    <TextBox x:Name="txtEmail"
             Width="239"
             Height="22"
             Margin="10"
             Text="test@example.com"/>
                    <Button Content="Pay"
        Click="Button_Click"
        Width="116"
        Background="Red"
        Foreground="White"
        FontWeight="Bold"
        FontSize="16"
        Height="25"/>
                </StackPanel>

            </StackPanel>

        </Border>

    </Grid>
</Window>